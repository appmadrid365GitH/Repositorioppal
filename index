<script>

const buttons = {

    es: document.getElementById("es"),

    en: document.getElementById("en")

};


function setLang(lang) {

    document.documentElement.lang = lang;


    document
        .querySelectorAll("[data-es]")
        .forEach(element => {

            element.innerHTML =
                element.dataset[lang];

        });


    buttons.es.classList.toggle(
        "active",
        lang === "es"
    );


    buttons.en.classList.toggle(
        "active",
        lang === "en"
    );


    localStorage.setItem(
        "appmadrid365-lang",
        lang
    );

}


buttons.es.onclick = () => {

    setLang("es");

};


buttons.en.onclick = () => {

    setLang("en");

};


setLang(
    localStorage.getItem(
        "appmadrid365-lang"
    ) || "es"
);

</script>


